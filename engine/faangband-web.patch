+#ifdef __EMSCRIPTEN__
+static void web_knowledge_name(char *name, size_t size,
+	const member_funcs *members, int oid)
+{
+	if (members->display_member == display_artifact) {
+		get_artifact_display_name(name, size, oid);
+	} else if (members->display_member == display_object) {
+		struct object_kind *kind = &k_info[oid];
+		object_kind_name(name, size, kind, OPT(player, cheat_xtra));
+		if (kind->tried && kind->flavor && !kind->aware)
+			my_strcat(name, " {tried}", size);
+	} else {
+		const char *label;
+		if (members->display_member == display_monster)
+			label = r_info[default_item_id(oid)].name;
+		else if (members->display_member == display_ego_item)
+			label = e_info[default_item_id(oid)].name;
+		else if (members->display_member == display_rune)
+			label = rune_name(oid);
+		else if (members->display_member == display_feature)
+			label = f_info[oid].name;
+		else
+			label = trap_info[oid].desc;
+		my_strcpy(name, label, size);
+	}
+}
+
+static const char *web_knowledge_detail(const member_funcs *members, int oid)
+{
+	if (members->display_member == display_monster) {
+		int race_index = default_item_id(oid);
+		const struct monster_race *race = &r_info[race_index];
+		if (!race->rarity) return "Shape";
+		if (rf_has(race->flags, RF_UNIQUE))
+			return race->max_num ? "Alive" : "Dead";
+		return format("Kills: %d", l_list[race_index].pkills);
+	}
+	if (members->display_member == display_object) {
+		struct object_kind *kind = &k_info[oid];
+		bool ignoring = kind->aware ? kind_is_ignored_aware(kind) : kind_is_ignored_unaware(kind);
+		const char *note = get_autoinscription(kind, kind->aware);
+		if (!ignoring) return note;
+		return note ? format("Ignored · %s", note) : "Ignored";
+	}
+	if (members->display_member == display_rune)
+		return quark_str(rune_note(oid));
+	return NULL;
+}
+
+static void web_knowledge_row_info(const member_funcs *members, int oid)
+{
+	if (members->display_member == display_object) {
+		const struct object_kind *kind = &k_info[oid];
+		web_set_row_group(kind->aware || !kind->flavor ? "Known" : "Unknown", false);
+	}
+	if (members->display_member == display_feature || members->display_member == display_trap)
+		web_set_row_symbol(*members->xattr(oid), *members->xchar(oid));
+}
+
+static int web_select_card_action(struct menu *m, const char *title, textblock *detail)
+{
+	m->title = title;
+	m->web_card = detail;
+	m->web_no_keyboard = true;
+	menu_layout(m, &SCREEN_REGION);
+	int action = menu_dynamic_select(m);
+	menu_dynamic_free(m);
+	return action;
+}
+
+static void web_inscription_card(textblock *detail, const char *title, int oid, bool rune)
+{
+	for (;;) {
+		struct menu *m = menu_dynamic_new();
+		const char *note;
+		if (rune) {
+			note = quark_str(rune_note(oid));
+		} else {
+			struct object_kind *kind = &k_info[oid];
+			if (ignore_tval(kind->tval)) {
+				bool ignored = kind->aware ? kind_is_ignored_aware(kind) :
+					kind_is_ignored_unaware(kind);
+				menu_dynamic_add(m, ignored ? "Unignore" : "Ignore", 's');
+			}
+			note = get_autoinscription(kind, kind->aware);
+		}
+		menu_dynamic_add(m, note ? "Edit auto-inscription" : "Auto-inscribe", '{');
+		if (note) menu_dynamic_add(m, "Remove auto-inscription", '}');
+		textblock *body = textblock_new();
+		textblock_append_textblock(body, detail);
+		if (note) textblock_append(body, "\n\nAuto-inscription: %s", note);
+		int action = web_select_card_action(m, title, body);
+		textblock_free(body);
+		if (action < 0) break;
+		struct keypress key = { EVT_KBRD, action, 0 };
+		if (rune) rune_xtra_act(key, oid);
+		else o_xtra_act(key, oid);
+	}
+}
+
+static void web_terrain_card(int oid, bool trap)
+{
+	const char *title = trap ? trap_info[oid].desc : f_info[oid].name;
+	const char *description = trap ? trap_info[oid].text : f_info[oid].desc;
+	const char *const lights[] = {
+		[LIGHTING_LIT] = "lit", [LIGHTING_TORCH] = "torch",
+		[LIGHTING_LOS] = "LOS", [LIGHTING_DARK] = "dark"
+	};
+	for (;;) {
+		enum grid_light_level light = trap ? t_uik_lighting : f_uik_lighting;
+		textblock *body = textblock_new();
+		textblock_append_pict(body, trap ? *t_xattr(oid) : *f_xattr(oid),
+			trap ? *t_xchar(oid) : *f_xchar(oid));
+		textblock_append(body, "  Lighting: %s", lights[light]);
+		if (description) textblock_append(body, "\n\n%s", description);
+		struct menu *m = menu_dynamic_new();
+		menu_dynamic_add(m, "Cycle lighting", 't');
+		int action = web_select_card_action(m, title, body);
+		textblock_free(body);
+		if (action < 0) break;
+		struct keypress key = { EVT_KBRD, action, 0 };
+		if (trap) t_xtra_act(key, oid);
+		else f_xtra_act(key, oid);
+	}
+}
