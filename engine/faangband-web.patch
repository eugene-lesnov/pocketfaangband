+static bool web_save_keymaps(int mode)
+{
+	const char *file = mode == KEYMAP_MODE_ROGUE ? WEB_KEYMAP_FILE_ROGUE : WEB_KEYMAP_FILE_ORIG;
+	char dest[1024], temp[1024];
+	path_build(dest, sizeof(dest), ANGBAND_DIR_USER, file);
+	path_build(temp, sizeof(temp), ANGBAND_DIR_USER, "pocket-keymaps.tmp");
+	ang_file *out = file_open(temp, MODE_WRITE, FTYPE_TEXT);
+	if (!out) return false;
+	keymap_dump(out);
+	if (!file_close(out) || !file_move(temp, dest)) {
+		file_delete(temp);
+		return false;
+	}
+	return web_sync_profile();
+}
+
+static void web_edit_keymaps(const char *title, int row)
+{
+	const char *const actions[] = { "Create or edit a keymap", "Query a keymap", "Remove a custom keymap", "Save keymaps" };
+	int mode = OPT(player, rogue_like_commands) ? KEYMAP_MODE_ROGUE : KEYMAP_MODE_ORIG;
+	for (;;) {
+		int choice = web_choose_option(title, actions, N_ELEMENTS(actions), 0);
+		if (choice < 0) return;
+		if (choice != 3) {
+			enum web_input_mode previous = web_set_input_mode(WEB_INPUT_KEY);
+			const char *old_prompt = web_set_prompt("Press the key to map");
+			struct keypress trigger = inkey();
+			web_set_prompt(old_prompt);
+			web_set_input_mode(previous);
+			if (trigger.code == ESCAPE) continue;
+			if (trigger.code == '0' || trigger.code == '^' || trigger.code == '\\' ||
+					(trigger.code > UCHAR_MAX && !keycode_find_desc(trigger.code))) {
+				web_option_notice("Choose another key. This key cannot trigger a keymap.");
+				continue;
+			}
+			const struct keypress *existing = keymap_find(mode, trigger);
+			char buffer[512] = "";
+			if (existing) keypress_to_text(buffer, sizeof(buffer), existing, true);
+			if (choice == 1) {
+				web_option_notice(existing ? format("Keymap action: %s", buffer) : "No keymap with that trigger.");
+				continue;
+			}
+			if (choice == 2) {
+				if (!get_check("Remove this custom keymap? ")) continue;
+				if (!keymap_remove_custom(mode, trigger)) {
+					web_option_notice("No custom keymap with that trigger.");
+					continue;
+				}
+			} else {
+				struct keypress sequence[KEYMAP_ACTION_MAX + 1];
+				if (!get_string("Keymap action (up to 20 keys, e.g. m1a or [Enter]): ", buffer, sizeof(buffer))) continue;
+				bool valid = keypress_from_text(sequence, N_ELEMENTS(sequence), buffer) && sequence[0].type;
+				for (int i = 0; valid && sequence[i].type; i++) {
+					if (!sequence[i].code || (sequence[i].code > UCHAR_MAX && !keycode_find_desc(sequence[i].code)))
+						valid = false;
+				}
+				if (!valid) {
+					web_option_notice("Enter 1 to 20 valid keys.");
+					continue;
+				}
+				keymap_add(mode, trigger, sequence, true);
+			}
+		}
+		web_option_notice(web_save_keymaps(mode) ? "Keymaps saved." : "Could not save keymaps. Choose Save keymaps to retry.");
+	}
+}
+#endif
