+static void web_search_knowledge(struct menu *m)
+{
+	web_begin_search();
+	web_search_entry = WEB_SEARCH_COLLECT;
+	for (int i = 0; i < m->count; i++) {
+		const menu_action *action = &((menu_action *)menu_priv(m))[i];
+		bool enabled = !(action->flags & (MN_ACT_GRAYED | MN_ACT_HIDDEN));
+		char label[160];
+		web_knowledge_label(label, sizeof(label), action);
+		web_search_section(i, label, action->action == do_cmd_knowledge_home, enabled);
+		if (enabled) action->action(action->name, i);
+	}
+	web_search_entry = WEB_SEARCH_CLOSED;
+	int cursor = -1;
+	for (;;) {
+		web_set_menu(m, cursor, NULL);
+		web_set_menu_title("Knowledge");
+		web_show_search_rows();
+		enum web_input_mode previous = web_set_input_mode(WEB_INPUT_MENU);
+		ui_event event = inkey_ex();
+		web_set_input_mode(previous);
+		if (event.type == EVT_ESCAPE || (event.type == EVT_KBRD && event.key.code == ESCAPE)) break;
+		if (event.type != EVT_WEB_MENU_ROW) continue;
+		int entry;
+		int section = web_search_target(event.key.code, &entry);
+		if (section < 0 || section >= m->count) continue;
+		const menu_action *action = &((menu_action *)menu_priv(m))[section];
+		if (action->flags & (MN_ACT_GRAYED | MN_ACT_HIDDEN)) continue;
+		cursor = event.key.code;
+		web_search_entry = entry;
+		action->action(action->name, section);
+		web_search_entry = WEB_SEARCH_CLOSED;
+	}
+	web_end_search();
+}
+static bool web_search_key(struct menu *m, const ui_event *event, int oid)
+{
+	if (event->type != EVT_KBRD || event->key.code != '/') return false;
+	web_search_knowledge(m);
+	return true;
+}
