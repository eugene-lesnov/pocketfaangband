+	}
+	if (!count) web_add_results_entry(filter ? "No other known differences." :
+		"No differences in the compared properties.", NULL, false);
+}
+
+static void web_manual_comparison(struct web_comparison_menu *view, int anchor)
+{
+	int cursor = 0;
+	for (;;) {
+		int other = web_pick_comparison_item(view, MANUAL_PAIR, anchor, &cursor);
+		if (other < 0) return;
+		const struct equippable *a = &the_summary->items[anchor], *b = &the_summary->items[other];
+		bool replacement = a->slot == b->slot && (a->src == EQUIP_SOURCE_WORN) != (b->src == EQUIP_SOURCE_WORN);
+		if (replacement && b->src == EQUIP_SOURCE_WORN)
+			web_compare_pair(view, other, anchor, true);
+		else
+			web_compare_pair(view, anchor, other, replacement);
+		web_wait_for_back(WEB_INPUT_RESULTS_LIST);
+	}
+}
+
+static void web_preview_replacement(struct web_comparison_menu *view, int worn, int candidate, int anchor)
+{
+	const struct equippable *item = &the_summary->items[candidate];
+	char **names = menu_priv(&view->menu);
+	for (;;) {
+		textblock *description = NULL;
+		if (worn >= 0) {
+			web_compare_pair(view, worn, candidate, true);
+		} else {
+			web_set_results_list("Equippable comparison");
+			web_add_results_section("Currently equipped");
+			bool valid_slot = item->slot >= 0 && item->slot < player->body.count;
+			web_add_results_entry(valid_slot ? "Empty slot" : "No equipment slot",
+				valid_slot ? player->body.slots[item->slot].name : NULL, false);
+			if (valid_slot) web_add_results_section("After equipping");
+			web_add_results_entry(names[candidate], web_item_location(item), false);
+			if (view->filter) {
+				char value[80];
+				const struct web_comparison_property *prop = view->filter;
+				web_comparison_value(value, sizeof(value), web_item_property(item, prop),
+					prop->known, prop->sustain ? 1 : prop->category);
+				web_add_results_section("Selected property");
+				web_add_results_entry(prop->label, value, false);
+			}
+			description = object_info(item->obj, OINFO_NONE);
+		}
+		bool manual = web_show_results(description, the_summary->nitems > 1 ? 'c' : 0, web_manual_label);
+		if (description) textblock_free(description);
+		if (!manual) return;
+		web_manual_comparison(view, anchor);
+	}
+}
+
+static void web_compare_selection(struct web_comparison_menu *view, int anchor)
+{
+	const struct equippable *item = &the_summary->items[anchor];
+	bool worn = item->src == EQUIP_SOURCE_WORN;
+	if (!worn) {
+		const struct object *equipped = NULL;
+		if (item->slot >= 0 && item->slot < player->body.count)
+			equipped = slot_object(player, item->slot);
+		if (!equipped || !tval_is_ring(item->obj)) {
+			int current = -1;
+			for (int i = 0; equipped && i < the_summary->nitems; i++) {
+				if (the_summary->items[i].obj == equipped) {
+					current = i;
+					break;
+				}
+			}
+			web_preview_replacement(view, current, anchor, anchor);
+			return;
+		}
+	}
+	int cursor = 0;
+	for (;;) {
+		int other = web_pick_comparison_item(view, worn ? REPLACEMENTS : WORN_RINGS, anchor, &cursor);
+		if (other == COMPARE_BACK) return;
+		if (other == COMPARE_MANUALLY) web_manual_comparison(view, anchor);
+		else if (worn) web_preview_replacement(view, anchor, other, anchor);
+		else web_preview_replacement(view, other, anchor, anchor);
+	}
+}
+
+static void web_equip_comparison(void)
+{
+	if (initialize_summary(player, &the_summary) || the_summary->nitems == 0) {
+		if (web_search_entry == WEB_SEARCH_COLLECT) return;
+		web_set_results_list("Equippable comparison");
+		web_add_results_entry("No equippable items.", NULL, false);
+		web_wait_for_back(WEB_INPUT_RESULTS_LIST);
+		return;
+	}
+	int count = the_summary->nitems;
+	if (web_search_entry >= count) return;
+	bool collecting = web_search_entry == WEB_SEARCH_COLLECT;
+	char **names = collecting ? NULL : mem_alloc(count * sizeof(*names));
+	for (int i = 0; i < count; i++) {
+		const struct equippable *item = &the_summary->items[i];
+		char name[256];
+		object_desc(name, sizeof(name), item->obj, ODESC_FULL | (collecting ? ODESC_NO_SEEN : 0) |
+			(item->src == EQUIP_SOURCE_STORE ? ODESC_STORE : 0), player);
+		if (collecting) {
+			web_add_search_entry(i, name, item->store_name ? item->store_name :
+				web_item_sources[item->src], NULL);
+		} else names[i] = string_make(name);
+	}
+	if (collecting) return;
+	struct web_comparison_property *properties = mem_alloc(
+		(the_summary->nprop + the_summary->propcats[4].n) * sizeof(*properties));
+	struct web_comparison_menu view = {
+		.properties = properties,
+		.nproperties = web_comparison_properties(properties),
+		.indices = mem_alloc(count * sizeof(*view.indices))
+	};
+	struct menu *m = &view.menu;
+	menu_init(m, MN_SKIN_SCROLL, menu_find_iter(MN_ITER_STRINGS));
+	menu_setpriv(m, count, names);
+	m->web_render = web_comparison_rows;
+	m->web_no_keyboard = true;
+	menu_layout(m, &SCREEN_REGION);
+	if (web_search_entry >= 0) {
+		web_compare_selection(&view, web_search_entry);
+	} else {
+		int cursor = 0;
+		int selected;
+		while ((selected = web_pick_comparison_item(&view, ALL_ITEMS, -1, &cursor)) >= 0)
+			web_compare_selection(&view, selected);
+	}
+	mem_free(view.indices);
+	mem_free(properties);
+	for (int i = 0; i < count; i++) string_free(names[i]);
+	mem_free(names);
+}
