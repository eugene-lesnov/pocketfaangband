+
+static int web_comparison_properties(struct web_comparison_property *properties)
+{
+	int count = 0;
+	for (int i = 0; i < (int)N_ELEMENTS(the_summary->propcats); i++) {
+		const struct prop_category *cat = &the_summary->propcats[i];
+		for (int j = 0; j < cat->n; j++) {
+			char label[320];
+			wchar_t wide[80];
+			get_ui_entry_label(cat->entries[j], N_ELEMENTS(wide), false, wide);
+			size_t end = wcslen(wide);
+			while (end && wide[end - 1] == L' ') wide[--end] = 0;
+			if (wcstombs(label, wide, sizeof(label)) == (size_t)-1) continue;
+			struct web_comparison_property *prop = &properties[count++];
+			prop->column = cat->off + j;
+			prop->category = i;
+			prop->known = is_ui_entry_for_known_rune(cat->entries[j], player);
+			prop->sustain = false;
+			my_strcpy(prop->label, label, sizeof(prop->label));
+			if (i == 4) {
+				struct web_comparison_property *sustain = &properties[count++];
+				*sustain = *prop;
+				sustain->sustain = true;
+				strnfmt(sustain->label, sizeof(sustain->label), "Sustain %s", label);
+			}
+		}
+	}
+	return count;
+}
+
+static int web_item_property(const struct equippable *item,
+		const struct web_comparison_property *property)
+{
+	return property->sustain ? item->auxvals[property->column] : item->vals[property->column];
+}
+
+static bool web_matches_property(const struct equippable *item,
+		const struct web_comparison_property *property)
+{
+	int value = web_item_property(item, property);
+	if (value == UI_ENTRY_UNKNOWN_VALUE || value == UI_ENTRY_VALUE_NOT_PRESENT) return false;
+	return property->category == 0 ? value < RES_LEVEL_BASE : value > 0;
+}
+
+static const char *web_filter_label(const struct web_comparison_property *property)
+{
+	return property->category == 0 ? format("%s resistance", property->label) : property->label;
+}
+
+static const struct web_comparison_property *web_choose_property(
+		const struct web_comparison_property *properties, int count,
+		const struct web_comparison_property *current)
+{
+	struct menu *m = menu_dynamic_new();
+	m->title = "Filter by property";
+	m->web_no_keyboard = true;
+	menu_dynamic_add(m, "All items", count);
+	for (int i = 0; i < count; i++) {
+		for (int j = 0; j < the_summary->nitems; j++) {
+			if (!web_matches_property(&the_summary->items[j], &properties[i])) continue;
+			if (&properties[i] == current) m->cursor = m->count;
+			menu_dynamic_add(m, web_filter_label(&properties[i]), i);
+			break;
+		}
+	}
+	if (m->count == 1)
+		menu_dynamic_add_valid(m, "No known properties to filter by.", count, MN_ROW_INVALID);
+	menu_layout(m, &SCREEN_REGION);
+	int choice = menu_dynamic_select(m);
+	menu_dynamic_free(m);
+	if (choice < 0) return current;
+	return choice == count ? NULL : &properties[choice];
+}
+
+static const char *web_item_location(const struct equippable *item)
+{
+	if (item->src == EQUIP_SOURCE_WORN) {
+		int slot = object_slot(player->body, item->obj);
+		return equip_mention(player, slot);
+	}
+	return item->store_name ? item->store_name : web_item_sources[item->src];
+}
+
+static void web_comparison_rows(struct menu *m)
+{
+	const struct web_comparison_menu *view = (struct web_comparison_menu *)m;
+	const char **names = menu_priv(m);
+	web_set_menu(m, m->cursor, NULL);
+	web_set_menu_title(m->title);
+	if (view->list == ALL_ITEMS) web_menu_action('q', "Filter by property");
+	else if (view->list != MANUAL_PAIR) web_menu_action('c', web_manual_label);
+	for (int i = 0; i < m->filter_count; i++) {
+		int index = m->filter_list[i];
+		const struct equippable *item = &the_summary->items[index];
+		const char *detail = item->src == EQUIP_SOURCE_WORN ? web_item_location(item) : item->store_name;
+		web_add_menu_row(i, names[index], detail, NULL, 0, true);
+		bool collapse_stores = (view->list == ALL_ITEMS && !view->filter) || view->list == MANUAL_PAIR;
+		web_set_row_group(web_item_sources[item->src], item->src == EQUIP_SOURCE_STORE && collapse_stores);
+	}
+}
+
+static int web_pick_comparison_item(struct web_comparison_menu *view,
+		enum web_comparison_list list, int anchor, int *cursor)
+{
+	struct menu *m = &view->menu;
+	char **names = menu_priv(m);
+	view->list = list;
+	for (;;) {
+		char title[400];
+		int n = 0;
+		for (int i = 0; i < the_summary->nitems; i++) {
+			const struct equippable *item = &the_summary->items[i];
+			if (i == anchor) continue;
+			if (list == ALL_ITEMS && view->filter && !web_matches_property(item, view->filter)) continue;
+			if (list == WORN_RINGS || list == REPLACEMENTS) {
+				if (item->slot != the_summary->items[anchor].slot ||
+						(item->src == EQUIP_SOURCE_WORN) != (list == WORN_RINGS)) continue;
+			}
+			view->indices[n++] = i;
+		}
+		if (!n) {
+			web_set_results_list("Equippable comparison");
+			web_add_results_entry(names[anchor], web_item_location(&the_summary->items[anchor]), false);
+			web_add_results_entry("No replacements for this slot.", NULL, false);
+			bool manual = web_show_results(NULL, the_summary->nitems > 1 ? 'c' : 0, web_manual_label);
+			return manual ? COMPARE_MANUALLY : COMPARE_BACK;
+		}
+		switch (list) {
+		case ALL_ITEMS:
+			if (view->filter)
+				strnfmt(title, sizeof(title), "Compare an item · %s", web_filter_label(view->filter));
+			else my_strcpy(title, "Compare an item", sizeof(title));
+			break;
+		case REPLACEMENTS: strnfmt(title, sizeof(title), "Replacements for %s", names[anchor]); break;
+		case WORN_RINGS: strnfmt(title, sizeof(title), "Replace which ring with %s?", names[anchor]); break;
+		case MANUAL_PAIR: strnfmt(title, sizeof(title), "Compare %s with…", names[anchor]); break;
+		}
+		m->title = title;
+		m->switch_keys = list == ALL_ITEMS ? "q" : list == MANUAL_PAIR ? NULL : "c";
+		m->cursor = *cursor;
+		menu_set_filter(m, view->indices, n);
+		ui_event event = menu_select(m, 0, false);
+		*cursor = m->cursor;
+		if (event.type == EVT_SELECT) return view->indices[*cursor];
+		if (event.type != EVT_KBRD) return COMPARE_BACK;
+		if (event.key.code == 'c') return COMPARE_MANUALLY;
+		const struct web_comparison_property *next =
+			web_choose_property(view->properties, view->nproperties, view->filter);
+		if (next != view->filter) *cursor = 0;
+		view->filter = next;
+	}
+}
