+		steps = MAX(abs(known->grid.x - p->grid.x), abs(known->grid.y - p->grid.y));
+		if (steps > 0 && steps < nearest && explore_wants_pickup(p, known)) {
+			if (steps == 1)
+				return steps;
+			nearest = steps;
+		}
+	}
+	return nearest;
